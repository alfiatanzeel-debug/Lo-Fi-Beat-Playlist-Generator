# ==============================================================================
# LO-FI BEAT PLAYLIST GENERATOR - ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Google Gemini AI API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Supabase Cloud Database (Get free project from https://supabase.com)
# When omitted, the app automatically runs in Demo Mode using local persistent storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
